#!/bin/bash
# COSMIC Switchboard Toggle
# Part of the Debian-COSMIC / Desktop Brewery Project

SET_STATE=$1
CANARY_PKG="cosmic-canary"

usage() {
    echo "Usage: cosmic-toggle [on|off|status]"
    exit 1
}

check_canary() {
    echo "🔍 Checking JIT Canary status..."
    if ! dpkg -l "$CANARY_PKG" >/dev/null 2>&1; then
        echo "❌ Error: $CANARY_PKG is not installed. Please install it to ensure ABI safety."
        exit 1
    fi
    
    # Check for broken dependencies (ABI drift)
    if ! sudo apt-get check >/dev/null 2>&1; then
        echo "⚠️  Warning: System has unmet dependencies. ABI drift detected!"
        echo "Run 'sudo apt-get -f install' to see the conflict. You may need to rebuild COSMIC."
        exit 1
    fi
    echo "✅ Canary is healthy."
}

case "$SET_STATE" in
    on)
        check_canary
        echo "🚀 Merging COSMIC extension..."
        sudo systemd-sysext merge
        echo "✅ COSMIC is now active. Please restart GDM or log out manually."
        ;;
    off)
        echo "🔌 Unmerging COSMIC extension..."
        sudo systemd-sysext unmerge
        echo "✅ COSMIC is now inactive."
        ;;
    status)
        if systemd-sysext status | grep -q "cosmic"; then
            echo "🟢 STATUS: COSMIC Extension is ACTIVE."
        else
            echo "⚪ STATUS: COSMIC Extension is INACTIVE."
        fi
        echo "--- Details ---"
        systemd-sysext status
        ;;
    *)
        usage
        ;;
esac
