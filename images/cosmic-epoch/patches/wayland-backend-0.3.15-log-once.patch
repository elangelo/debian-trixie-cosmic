# wayland-backend 0.3.15: log a stored connection error only once.
# Upstream report: store_and_return_error() logs unconditionally on a sticky error.
--- a/src/sys/client_impl/mod.rs
+++ b/src/sys/client_impl/mod.rs
@@ -377,7 +377,13 @@
         } else {
             WaylandError::Io(err)
         };
-        crate::log_error!("{err}");
+        // Log only the first error. `last_error` is sticky, so a caller that keeps dispatching a
+        // dead connection re-enters this function on every attempt; logging each time floods
+        // stderr without adding information (`log_error!` is `eprintln!` without the `log`
+        // feature -- unbuffered and not rate-limited).
+        if self.last_error.is_none() {
+            crate::log_error!("{err}");
+        }
         self.last_error = Some(err.clone());
         err
     }
